#!/bin/sh
# antirea self-heal hook — pre-commit
# Restores barrier files and stages them if they were deleted before commit.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then exit 0; fi

INJECT="$REPO_ROOT/.git/antirea-barrier.md"
if [ ! -f "$INJECT" ]; then exit 0; fi

restore_and_stage() {
  local target="$1"
  local dir
  dir="$(dirname "$target")"
  if [ ! -f "$target" ]; then
    mkdir -p "$dir"
    cat "$INJECT" > "$target"
    git add "$target"
    echo "[antirea] Restored and staged: $target"
  fi
}

restore_and_stage "$REPO_ROOT/AGENTS.md"
restore_and_stage "$REPO_ROOT/CLAUDE.md"
restore_and_stage "$REPO_ROOT/.re-deny"
restore_and_stage "$REPO_ROOT/.cursor/rules"
restore_and_stage "$REPO_ROOT/.github/copilot-instructions.md"
restore_and_stage "$REPO_ROOT/.github/AGENTS.md"